# Clerk — Dashboard → API keys (written by `clerk init` / `clerk env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase — Dashboard → Project Settings → API Keys
# URL: Project URL (https://xxxx.supabase.co)
# Publishable key → NEXT_PUBLIC_SUPABASE_ANON_KEY
# Secret key → SUPABASE_SERVICE_ROLE_KEY (server only, never expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — reads an uploaded travel plan and fills the quote form.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Resend — https://resend.com
RESEND_API_KEY=re_your_key
CONTACT_TO_EMAIL=team@example.com
# Optional: inbox for new quote orders (falls back to CONTACT_TO_EMAIL)
ORDERS_TO_EMAIL=
CONTACT_FROM_EMAIL=Berro <notifications@your-domain.com>
# Public site URL used in order notification links (no trailing slash)
APP_URL=http://localhost:3000

# Google Maps — Google Cloud Console → APIs & Services → Credentials
# Server key with Places API (New) and Routes API enabled. Without it, the built-in place list and
# straight-line distance estimates are used.
GOOGLE_MAPS_API_KEY=
# Browser key with Maps Embed API enabled, restricted to your site's domain. Shows the route map.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
