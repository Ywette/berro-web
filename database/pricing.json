  "pricingRules": {
    "local": "billedHours=max(totalDutyHours,minHours); base=billedHours*hourlyRate; includedKm=billedHours*localIncludedKmPerBilledHour; waiting=waitingHours*waitingPerHour",
    "dayAndLong": "base=days*dailyRate; includedKm=days*includedKmPerDay; overtime=max(0,totalDutyHours-days*standardHoursInDailyRate)*overtimePerHour",
    "all": "extraKm=max(0,loadedKm-includedKm)*extraKmRate; deadhead=deadheadKm*deadheadRatePerKm; busCharges=base+extraKm+overtime+waiting+deadhead; uplift=busCharges*(weekend+peak+lastMinute); overnight=nightsAway*(allowance+hotel); secondDriver=days*cost if secondDriver; guide=days*cost if guide; border=fee if borderCrossing; totalExVat=busCharges+uplift+overnight+secondDriver+guide+border+tollsParking; totalInclVat=totalExVat*(1+vat); pricePerPerson=totalInclVat/passengers",
    "checks": "capacity: passengers<=seats; EU driving: loadedKm/avgSpeedKmh/days <= maxDrivingHoursPerDay else second driver or extra day"
  },
